<%- include('partials/header') %>

    <main>
        <h2>Users</h2>
        
        <p>All registered users and their roles.</p>
        
        <table class="users-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                </tr>
            </thead>
        
            <tbody>
                <% users.forEach(user=> { %>
                    <tr>
                        <td>
                            <%= user.name %>
                        </td>
                        <td>
                            <%= user.email %>
                        </td>
                        <td>
                            <%= user.role_name %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </main>

    <%- include('partials/footer') %>