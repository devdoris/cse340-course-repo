<%- include("partials/header") %>

    <main>

        <h1>Edit Project</h1>

        <% if (errors && errors.length> 0) { %>
            <ul>
                <% errors.forEach(error=> { %>
                    <li>
                        <%= error.msg %>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

        <form action="/edit-project/<%= project.project_id %>" method="POST">

            <label for="title">Project Title</label>

            <input id="title" name="title" type="text" required minlength="3" maxlength="150" value="<%= project.title %>">

            <label for="description">Description</label>

            <textarea id="description" name="description" required maxlength="1000"><%= project.description %></textarea>

            <label for="location">Location</label>

            <input id="location" name="location" type="text" required maxlength="100" value="<%= project.location %>">

            <label for="projectDate">Project Date</label>
            
            <input id="projectDate" name="projectDate" type="date" required value="<%= projectDate %>">

            <label for="organizationId">Organization</label>

            <select id="organizationId" name="organizationId" required>

                <% organizations.forEach(organization=> { %>

                    <option value="<%= organization.organization_id %>"
                        <%=String(organization.organization_id)===String(project.organization_id) ? "selected" : "" %>
                        >
                        <%= organization.name %>
                    </option>

                    <% }) %>

            </select>

            <button type="submit">
                Update Project
            </button>

        </form>

    </main>

    <%- include("partials/footer") %>