<%- include('partials/header') %>

    <main>

        <h1>
            <%= title %>
        </h1>

        <h2>Here are our partner organizations.</h2>

        <% if (message) { %>
            <p class="flash-message">
                <%= message %>
            </p>
            <% } %>

        <% if (user && user.role_name==="admin" ) { %>
            <a href="/new-organization" class="btn">Add New Organization</a>
            <% } %>

        <ul>

            <% organizations.forEach(organization=> { %>

                <li>

                    <img class="organization-logo" src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">

                    <h2>

                        <a href="/organization/<%= organization.organization_id %>">

                            <%= organization.name %>

                        </a>

                    </h2>

                    <p>
                        <%= organization.contact_email %>
                    </p>

                    <p>
                        <%= organization.description %>
                    </p>

                </li>

                <% }) %>

        </ul>

    </main>

    <%- include('partials/footer') %>