<%- include("partials/header") %>

    <main>

        <h1>Edit Category</h1>

        <% if (typeof error !=="undefined" && error) { %>
        
            <p class="error-message">
                <%= error %>
            </p>
        
            <% } %>

        <form action="/edit-category/<%= category.category_id %>" method="POST">

            <label for="name">
                Category Name
            </label>

            <input id="name" name="name" type="text" required minlength="3" maxlength="100" value="<%= category.name %>">

            <button type="submit">
                Update Category
            </button>

        </form>

    </main>

    <%- include("partials/footer") %>