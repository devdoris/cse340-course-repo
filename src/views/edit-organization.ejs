<%- include("partials/header") %>

    <main>

        <h1>Edit Organization</h1>

        <% if (errors && errors.length> 0) { %>
            <ul>
                <% errors.forEach(error=> { %>
                    <li>
                        <%= error.msg %>
                    </li>
                    <% }) %>
            </ul>
            <% } %>

                <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST">

                    <label for="name">Organization Name</label>

                    <input id="name" name="name" type="text" required maxlength="150"
                        value="<%= organizationDetails.name %>">

                    <label for="description">Description</label>

                    <textarea id="description" name="description"
                        required><%= organizationDetails.description %></textarea>

                    <label for="contactEmail">Contact Email</label>

                    <input id="contactEmail" name="contactEmail" type="email" required maxlength="255"
                        value="<%= organizationDetails.contact_email %>">

                    <label for="logoFilename">Logo Filename</label>

                    <input id="logoFilename" name="logoFilename" type="text" required maxlength="255"
                        value="<%= organizationDetails.logo_filename %>">

                    <button type="submit">
                        Update Organization
                    </button>

                </form>

    </main>

    <%- include("partials/footer") %>