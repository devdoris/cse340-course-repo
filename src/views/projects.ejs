<%- include('partials/header') %>

    <main>

        <h1>
            <%= title %>
        </h1>

        <% if (message) { %>
            <p class="flash-message">
                <%= message %>
            </p>
            <% } %>

        <a href="/new-project" class="btn">
            Create New Project
        </a>

        <ul>

            <% projects.forEach(project=> { %>

                <li>

                    <h2>

                        <a href="/project/<%= project.project_id %>">

                            <%= project.title %>

                        </a>

                    </h2>

                    <p>

                        <strong>Date:</strong>

                        <%= new Date(project.project_date).toLocaleDateString() %>

                    </p>

                    <p>

                        <strong>Organization:</strong>

                        <a href="/organization/<%= project.organization_id %>">

                            <%= project.organization_name %>

                        </a>

                    </p>

                </li>

                <% }) %>

        </ul>

    </main>

    <%- include('partials/footer') %>