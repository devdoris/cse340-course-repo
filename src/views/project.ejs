<%- include('partials/header') %>

    <main>

        <h1>
            <%= project.title %>
        </h1>

        <a href="/edit-project/<%= project.project_id %>">
            Edit Project
        </a>
        
        <a href="/assign-categories/<%= project.project_id %>">
            Edit Categories
        </a>

        <p>
            <%= project.description %>
        </p>

        <p>

            <strong>Date:</strong>

            <%= new Date(project.project_date).toLocaleDateString() %>

        </p>

        <p>

            <strong>Location:</strong>

            <%= project.location %>

        </p>

        <p>

            <strong>Organization:</strong>

            <a href="/organization/<%= project.organization_id %>">

                <%= project.organization_name %>

            </a>

        </p>

        <h2>Categories</h2>

        <ul>

            <% categories.forEach(category=> { %>

                <li>

                    <a href="/category/<%= category.category_id %>">

                        <%= category.name %>

                    </a>

                </li>

                <% }) %>

        </ul>

    </main>

    <%- include('partials/footer') %>