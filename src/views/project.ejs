<%- include('partials/header') %>

    <main>

        <h1>
            <%= project.title %>
        </h1>

        <% if (projectMessage) { %>
            <p class="flash-message">
                <%= projectMessage %>
            </p>
            <% } %>

        <% if (user && user.role_name==="admin" ) { %>
            <a href="/edit-project/<%= project.project_id %>" class="btn">
                Edit Project
            </a>
            <% } %>
        
        <% if (user && user.role_name==="admin" ) { %>
            <a href="/assign-categories/<%= project.project_id %>" class="btn">
            Edit Categories
            </a>
            <% } %>
        <% if (user) { %>
        
            <% if (isVolunteer) { %>
        
                <p>
                    <strong>You are volunteering for this project.</strong>
                </p>
        
                <a href="/remove-volunteer/<%= project.project_id %>" class="btn">
                    Remove Volunteer
                </a>
        
                <% } else { %>
        
                    <a href="/volunteer/<%= project.project_id %>" class="btn">
                        Volunteer for this Project
                    </a>
        
                    <% } %>
        
                        <% } %>

        <p>
            <%= project.description %>
        </p>

        <p>

            <strong>Date:</strong>

            <%= new Date(project.project_date).toLocaleDateString() %>

        </p>

        <p>

            <strong>Location:</strong>

            <%= project.location %>

        </p>

        <p>

            <strong>Organization:</strong>

            <a href="/organization/<%= project.organization_id %>">

                <%= project.organization_name %>

            </a>

        </p>

        <h2>Categories</h2>

        <ul>

            <% categories.forEach(category=> { %>

                <li>

                    <a href="/category/<%= category.category_id %>">

                        <%= category.name %>

                    </a>

                </li>

                <% }) %>

        </ul>

    </main>

    <%- include('partials/footer') %>